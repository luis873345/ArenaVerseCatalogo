
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ArenaVerse - Iniciar sesión</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: #080d20;
      color: white;
    }

    .login {
      width: min(90%, 380px);
      padding: 32px 24px;
      border: 1px solid #1769ff;
      border-radius: 18px;
      background: #101a35;
      box-shadow: 0 0 25px #075bff35;
      text-align: center;
    }

    h1 {
      color: #51c8ff;
      margin-top: 0;
    }

    p { color: #b9c8e8; }

    input, button {
      width: 100%;
      padding: 14px;
      margin-top: 14px;
      border-radius: 9px;
      font-size: 16px;
    }

    input {
      border: 1px solid #385a91;
      background: #080f25;
      color: white;
      outline: none;
    }

    button {
      border: 0;
      background: linear-gradient(90deg, #087cff, #782cff);
      color: white;
      font-weight: bold;
      cursor: pointer;
    }

    #mensaje {
      min-height: 24px;
      font-size: 14px;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <main class="login">
    <h1>ArenaVerse</h1>
    <p>Ingresa tu contraseña para continuar.</p>

    <form id="formulario">
      <input
        id="contrasena"
        type="password"
        placeholder="Contraseña"
        autocomplete="current-password"
        required
      >

      <button type="submit">Iniciar sesión</button>
      <p id="mensaje" role="status"></p>
    </form>
  </main>

  <script>
    document.getElementById("formulario")
      .addEventListener("submit", function (evento) {
        evento.preventDefault();

        document.getElementById("mensaje").textContent =
          "Falta conectar el servicio de autenticación de ArenaVerse.";
      });
  </script>
</body>
</html>
